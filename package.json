{
  "name": "hammer",
  "version": "1.24.0",
  "description": "OpenAI-compatible local router that benchmarks free coding models across providers and forwards requests to the best available model.",
  "keywords": [
    "nvidia",
    "nim",
    "llm",
    "cli",
    "ai",
    "models",
    "benchmark",
    "latency",
    "availability",
    "deepseek",
    "qwen",
    "llama",
    "mistral",
    "glm",
    "kimi",
    "gpt",
    "chatgpt",
    "openai",
    "api"
  ],
  "license": "MIT",
  "author": "anonymous",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node bin/hammer.js",
    "desktop": "electron .",
    "desktop:package": "electron-packager . Hammer --executable-name=hammer --out=release --overwrite --prune --icon=desktop/assets/icon.png --ignore=\"^/(release|test|tools|docs|\\.git|\\.github|\\.freebuff|\\.cloud-attachments|\\.test-home)\"",
    "desktop:launcher": "node tools/install-desktop-launcher.mjs",
    "icons": "node tools/make-desktop-icons.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "verify:providers": "node tools/verify-providers.mjs",
    "sync:omniroute": "node tools/sync-omniroute-catalog.mjs"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "express": "^5.2.1",
    "undici": "^6.29.1"
  },
  "overrides": {
    "path-to-regexp": "8.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "electron": "^45.1.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
